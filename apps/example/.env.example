# PayPal sandbox credentials for the example. Copy this file to `.env` (ignored by git) and fill it in from
# https://developer.paypal.com/dashboard/applications/sandbox (an app's client ID and secret) and the sandbox business
# account that app belongs to (Account info: its merchant ID, also called the payer ID).

# Read by the app: public by design, like the client ID of any PayPal integration.
EXPO_PUBLIC_PAYPAL_CLIENT_ID=
EXPO_PUBLIC_PAYPAL_MERCHANT_ID=

# Read only by the API routes in app/api, which run in the dev server. Never prefix it with EXPO_PUBLIC_.
PAYPAL_CLIENT_SECRET=
